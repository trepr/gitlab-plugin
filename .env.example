# Application ID da aplicação OAuth registrada no GitLab interno (gitlab.tre-pr.jus.br)
# Obtenha em: GitLab -> User Settings -> Applications
GITLAB_OAUTH_CLIENT_ID=

# Client Secret (necessário caso a aplicação OAuth tenha sido criada com "Confidential" marcado)
# Se a aplicação for pública (não-confidencial), pode ser deixado em branco
GITLAB_OAUTH_CLIENT_SECRET=
